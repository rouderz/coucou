{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To jump to your terminal, send emails and control Music and Spotify."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para saltar a tu terminal, enviar correos y controlar Music y Spotify."
          }
        }
      }
    },
    "NSAccessibilityUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read the active window and the file you're editing, and attach them as context."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para leer la ventana activa y el archivo que editas, y adjuntarlos como contexto."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-to-talk: Mochi listens only while you hold the shortcut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsar para hablar: Mochi solo escucha mientras mantienes pulsado el atajo."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-to-talk: your voice is transcribed on this Mac to ask Mochi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsar para hablar: tu voz se transcribe en este Mac para preguntar a Mochi."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not disturb: Coucou stays quiet while you're in a calendar event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No molestar: Coucou se queda en silencio mientras estás en un evento del calendario."
          }
        }
      }
    }
  }
}