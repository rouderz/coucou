{
  "manifest_version": 3,
  "name": "Coucou for AliExpress",
  "description": "Groups your AliExpress orders by the box they ship in and makes one invoice per box in Coucou (Mochi), using your own session in this browser.",
  "version": "0.2.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://www.aliexpress.com/*",
    "https://*.alicdn.com/*",
    "https://*.aliexpress-media.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.aliexpress.com/p/order/index.html*",
        "https://www.aliexpress.com/p/order/detail.html*",
        "https://www.aliexpress.com/p/tracking/*"
      ],
      "js": [
        "aliexpress-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Coucou for AliExpress"
  }
}
