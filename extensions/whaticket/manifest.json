{
  "manifest_version": 3,
  "name": "Coucou for WhaTicket",
  "description": "Shows your whaticket.com queue in Coucou (Mochi) and accepts tickets from it, using your own session in this browser.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://api.whaticket.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://app.whaticket.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Coucou for WhaTicket" }
}
