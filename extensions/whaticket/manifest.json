{
  "manifest_version": 3,
  "name": "Coucou",
  "description": "Coucou (Mochi) in your browser: your whaticket.com queue, and your AliExpress orders grouped by package with one invoice per box — using your own sessions, nothing else.",
  "version": "0.2.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://api.whaticket.com/*",
    "https://www.aliexpress.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.whaticket.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.aliexpress.com/p/order/index.html*",
        "https://www.aliexpress.com/p/order/detail.html*",
        "https://www.aliexpress.com/p/tracking/*"
      ],
      "js": [
        "aliexpress-core.js",
        "aliexpress.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Coucou"
  }
}
